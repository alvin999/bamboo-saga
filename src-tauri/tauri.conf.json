{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "bamboo-saga",
  "version": "0.1.1",
  "identifier": "com.bamboosaga.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5188",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "廣零散 (bamboo-saga)",
        "width": 1160,
        "height": 780,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown 藥帖",
        "description": "廣零散 筆記藥帖",
        "role": "Editor"
      },
      {
        "ext": ["txt", "json", "log", "csv"],
        "name": "文字與資料藥帖",
        "description": "廣零散 檢視藥帖",
        "role": "Viewer"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
