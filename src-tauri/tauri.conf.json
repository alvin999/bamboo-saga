{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "bamboo-saga",
  "version": "0.1.7",
  "identifier": "com.bamboosaga.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5188",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "廣零散 (bamboo-saga)",
        "width": 1160,
        "height": 780,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown 藥帖",
        "description": "廣零散 筆記藥帖",
        "role": "Editor"
      },
      {
        "ext": [
          "txt",
          "json",
          "log",
          "csv"
        ],
        "name": "文字與資料藥帖",
        "description": "廣零散 檢視藥帖",
        "role": "Viewer"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCODEwMjhCMkNFNzhDRkUKUldUK2pPY3Npd0tCMjNWV253ME85UCtjT3BCMlBqTzNSR3BIZDdCN3MrRWEwblJhbVpSYjZPelYK",
      "endpoints": [
        "https://github.com/alvin999/bamboo-saga/releases/latest/download/latest.json"
      ]
    }
  }
}